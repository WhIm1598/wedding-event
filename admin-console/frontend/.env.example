# Base path of the admin REST API (proxied by Vite in dev, by nginx-gateway in production)
VITE_API_BASE_URL=/api/v1

# true  -> use the in-memory mock API (src/api/mock), no backend required
# false -> call admin-console/backend endpoints described in docs/features/detailed_functional_specification.md
VITE_USE_MOCK=true

# Dev-server proxy target for /api (admin-console/backend)
VITE_API_PROXY_TARGET=http://localhost:8082
