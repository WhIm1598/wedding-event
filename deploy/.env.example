# Copy to deploy/.env and fill in. .env is git-ignored: it holds the production secrets.
DOMAIN=admin.example.vn
# openssl rand -base64 32
DB_PASSWORD=
# openssl rand -base64 48   (at least 32 bytes; changing it signs everyone out)
JWT_SECRET=
# Platform admin (manages studios), created only while the database has none. Remove both lines after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Forgot the platform admin password: set ADMIN_EMAIL + a new ADMIN_PASSWORD + this to true, restart, then remove all three
ADMIN_RESET_PASSWORD=false
